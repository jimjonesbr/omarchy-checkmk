# The widget writes this file to ~/.config/omarchy-checkmk/config when you save
# the connection form, with the secret in the desktop keyring. Only needed when
# configuring by hand.

# Site URL, i.e. everything before /check_mk/
CMK_URL=http://localhost:8080/cmk

# Automation user, read-only rights (e.g. role "guest") are enough
CMK_USER=omarchy
# Without these two the secret is looked up in the keyring:
#   secret-tool store --label "Checkmk omarchy" application omarchy-checkmk url <CMK_URL> user <CMK_USER>
#CMK_SECRET_FILE=~/git/omarchy-checkmk/deploy-checkmk/omarchy.secret
#CMK_SECRET=

# Case-insensitive regular expressions, leave empty to watch everything
CMK_SERVICE_FILTER='^PostgreSQL'
CMK_HOST_FILTER=

# Seconds before a request to Checkmk gives up
CMK_TIMEOUT=10

# Set to 1 to accept self-signed certificates
CMK_INSECURE=0
