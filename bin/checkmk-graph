#!/bin/bash
#
# Fetch the history of the metrics of one service from Checkmk.
#
#   checkmk-graph < request
#
# reads one line of JSON from stdin:
#   {"server": "<server-id>", "host": "...", "service": "...", "seconds": 14400,
#    "metrics": ["load1", ...]}
#
# Prints JSON: {ok, error, start, end, step, curves: [{metric, title, color, points}]}
# with start and end in epoch seconds and one point every step seconds, null for gaps.
# The metrics are fetched in parallel, one request each.
#
# Host, service and metric names, the site URL and the answers never go on a
# command line, where every local user could read them in /proc: they travel
# through stdin, files in a private directory and curl's config stream.

set -uo pipefail
umask 077

BIN="$(dirname "$(realpath "$0")")"

fail() {
  CMK_ERROR="$1" jq -nc '{ok: false, error: $ENV.CMK_ERROR, curves: []}'
  exit 1
}

# One line of a curl config: the value quoted, with \ and " escaped and line
# breaks encoded, so that no value can start an option line of its own
curl_option() { # name value
  local v="${2//\\/\\\\}"
  v="${v//\"/\\\"}"
  v="${v//$'\n'/\\n}"
  printf '%s = "%s"\n' "$1" "${v//$'\r'/\\r}"
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

IFS= read -r line || true
jq -e '(.server | type == "string") and (.seconds | type == "number") and (.metrics | length > 0)' \
  >/dev/null 2>&1 <<<"$line" || fail "Invalid request"
printf '%s\n' "$line" > "$work/request.json"
id="$(jq -r .server "$work/request.json")"

"$BIN/checkmk-config" list | jq -c --arg id "$id" '.[] | select(.id == $id)' > "$work/server.json"
[[ -s "$work/server.json" ]] || fail "Unknown server $id"
url="$(jq -r .url "$work/server.json")"
user="$(jq -r .user "$work/server.json")"
secret="$("$BIN/checkmk-config" secret "$id")"
[[ -n "$secret" ]] || fail "No password or secret stored for this server"

seconds="$(jq -r '.seconds | floor' "$work/request.json")"
end="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
start="$(date -u -d "-$seconds seconds" +%Y-%m-%dT%H:%M:%SZ)"

args=(-sS --max-time 20 -w '%{http_code}' -H "Accept: application/json" -H "Content-Type: application/json")
[[ "$(jq -r '.insecure // false' "$work/server.json")" == true ]] && args+=(-k)
# Only the web: never a file:// or other URL curl would also take
config='proto = "=http,https"'$'\n'"$(curl_option url "$url/check_mk/api/1.0/domain-types/metric/actions/get/invoke")"
proxy="$(jq -r '.proxy // ""' "$work/server.json")"
[[ -n "$proxy" ]] && config+=$'\n'"$(curl_option proxy "$proxy")"

count="$(jq '.metrics | length' "$work/request.json")"
for ((i = 0; i < count; i++)); do
  # The site id is usually the last part of the site URL, e.g. https://host/prod
  jq -c --slurpfile server "$work/server.json" --argjson i "$i" --arg start "$start" --arg end "$end" '
    $server[0] as $s
    | {site: ($s.site // ($s.url | sub("/+$"; "") | split("/") | last)),
       host_name: .host, service_description: .service,
       type: "single_metric", metric_id: .metrics[$i],
       time_range: {start: $start, end: $end},
       reduce: "max"}
  ' "$work/request.json" > "$work/body$i"
  # The secret goes to curl through a file descriptor, never on its command line
  curl "${args[@]}" -K <(printf '%s\n' "$config") \
    -H @<(printf 'Authorization: Bearer %s %s\n' "$user" "$secret") \
    -X POST --data-binary @"$work/body$i" -o "$work/answer$i" \
    > "$work/code$i" 2> "$work/error$i" &
done
wait

# One metric without history (e.g. never stored) must not hide the others
for ((i = 0; i < count; i++)); do
  code="$(cat "$work/code$i" 2>/dev/null)"
  jq -e . "$work/answer$i" > "$work/answer$i.json" 2>/dev/null || echo 'null' > "$work/answer$i.json"
  CMK_CODE="$code" CMK_CURL_ERROR="$(head -1 "$work/error$i" 2>/dev/null | sed 's/^curl: ([0-9]*) //')" \
    jq -c --argjson i "$i" --slurpfile answer "$work/answer$i.json" '
      .metrics[$i] as $m | $answer[0] as $a
      | if $ENV.CMK_CODE == "200" and $a != null then
          {metric: $m, title: ($a.metrics[0].title // $m), color: ($a.metrics[0].color // ""),
           start: ($a.time_range.start | sub("\\+00:00$"; "Z") | fromdateiso8601),
           end: ($a.time_range.end | sub("\\+00:00$"; "Z") | fromdateiso8601),
           step: $a.step, points: ($a.metrics[0].data_points // [])}
        else
          {metric: $m, points: [],
           error: (($a | objects | .title // .detail) // (if $ENV.CMK_CURL_ERROR != "" then $ENV.CMK_CURL_ERROR
                   else "HTTP " + $ENV.CMK_CODE end))}
        end
    ' "$work/request.json"
done | jq -sc '
  (map(select(.error | not)) | .[0]) as $first
  | if $first == null then {ok: false, error: (.[0].error // "No data"), curves: .}
    else {ok: true, error: "", start: $first.start, end: $first.end, step: $first.step, curves: .} end
'
