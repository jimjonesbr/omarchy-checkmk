#!/bin/bash
#
# Fetch the history of the metrics of one service from Checkmk.
#
#   checkmk-graph <server-id> <host> <service> <seconds> <metric>...
#
# Prints JSON: {ok, error, start, end, step, curves: [{metric, title, color, points}]}
# with start and end in epoch seconds and one point every step seconds, null for gaps.
# The metrics are fetched in parallel, one request each.

set -uo pipefail

BIN="$(dirname "$(realpath "$0")")"

fail() {
  jq -nc --arg error "$1" '{ok: false, error: $error, curves: []}'
  exit 1
}

(($# >= 5)) || fail "usage: checkmk-graph <server-id> <host> <service> <seconds> <metric>..."
id="$1" host="$2" service="$3" seconds="$4"
shift 4

server="$("$BIN/checkmk-config" list | jq -c --arg id "$id" '.[] | select(.id == $id)')"
[[ -n "$server" ]] || fail "Unknown server $id"
url="$(jq -r .url <<<"$server")"
user="$(jq -r .user <<<"$server")"
# The site id is usually the last part of the site URL, e.g. https://host/prod
site="$(jq -r --arg u "$url" '.site // ($u | sub("/+$"; "") | split("/") | last)' <<<"$server")"
secret="$("$BIN/checkmk-config" secret "$id")"
[[ -n "$secret" ]] || fail "No password or secret stored for $user"

end="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
start="$(date -u -d "-$seconds seconds" +%Y-%m-%dT%H:%M:%SZ)"

args=(-sS --max-time 20 -w '\n%{http_code}'
  -H "Authorization: Bearer $user $secret" -H "Accept: application/json" -H "Content-Type: application/json")
[[ "$(jq -r '.insecure // false' <<<"$server")" == true ]] && args+=(-k)

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

i=0
for metric in "$@"; do
  body="$(jq -nc --arg site "$site" --arg host "$host" --arg service "$service" --arg metric "$metric" \
    --arg start "$start" --arg end "$end" '{
      site: $site, host_name: $host, service_description: $service,
      type: "single_metric", metric_id: $metric,
      time_range: {start: $start, end: $end},
      reduce: "max"
    }')"
  curl "${args[@]}" -X POST -d "$body" "$url/check_mk/api/1.0/domain-types/metric/actions/get/invoke" \
    > "$work/$i" 2>&1 &
  i=$((i + 1))
done
wait

i=0
results="[]"
for metric in "$@"; do
  response="$(cat "$work/$i")"
  code="${response##*$'\n'}"
  answer="${response%$'\n'*}"
  if [[ "$code" != 200 ]]; then
    # One metric without history (e.g. never stored) must not hide the others
    error="$(jq -r '.title // .detail // empty' <<<"$answer" 2>/dev/null)"
    results="$(jq -c --arg m "$metric" --arg e "${error:-HTTP $code}" '. + [{metric: $m, error: $e, points: []}]' <<<"$results")"
  else
    results="$(jq -c --arg m "$metric" --argjson a "$answer" '
      . + [{metric: $m, title: ($a.metrics[0].title // $m), color: ($a.metrics[0].color // ""),
            start: ($a.time_range.start | sub("\\+00:00$"; "Z") | fromdateiso8601),
            end: ($a.time_range.end | sub("\\+00:00$"; "Z") | fromdateiso8601),
            step: $a.step, points: ($a.metrics[0].data_points // [])}]
    ' <<<"$results")"
  fi
  i=$((i + 1))
done

jq -c '
  (map(select(.error | not)) | .[0]) as $first
  | if $first == null then {ok: false, error: (.[0].error // "No data"), curves: .}
    else {ok: true, error: "", start: $first.start, end: $first.end, step: $first.step, curves: .} end
' <<<"$results"
