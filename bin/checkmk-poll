#!/bin/bash
#
# Fetch service states from every configured Checkmk server, write them to a
# status file and send a desktop notification when services changed state since
# the previous run.
#
#   checkmk-poll              poll once
#   checkmk-poll --quiet      poll once without notifications
#
# Servers: see checkmk-config
# Output:  ${XDG_CACHE_HOME:-~/.cache}/omarchy-checkmk/status.json
#
# Nothing from Checkmk, nor the site URL or filters, goes on a command line, where
# every local user could read it in /proc: curl takes them from its config
# stream, jq from files and the environment. For the same reason notifications
# only count, e.g. "2 services are now CRIT", and clicking one opens the panel.

set -uo pipefail
# The status file and temporary files are for this user only
umask 077

BIN="$(dirname "$(realpath "$0")")"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-checkmk"
STATUS="$STATE_DIR/status.json"

notify=1
[[ "${1:-}" == "--quiet" ]] && notify=0

mkdir -p "$STATE_DIR"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# Only fixed texts and counts: whatever is passed here is on a command line
send_notification() { # urgency headline description panel-view
  ((notify)) || return 0
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send --app-name Checkmk -g "󰗶" -u "$1" "$2" "$3" --exec omarchy-shell checkmk show "$4"
  else
    notify-send -a Checkmk -u "$1" "$2" "$3"
  fi
}

# One line of a curl config: the value quoted, with \ and " escaped
curl_option() { # name value
  local v="${2//\\/\\\\}"
  printf '%s = "%s"\n' "$1" "${v//\"/\\\"}"
}

# Writes $WORK/<id>.json: {ok, error, services} with the normalised services of that server
fetch() { # server json
  local server="$1" id name url user secret timeout query response code body
  id="$(jq -r .id <<<"$server")"
  name="$(jq -r .name <<<"$server")"
  url="$(jq -r .url <<<"$server")"
  user="$(jq -r .user <<<"$server")"
  timeout="$(jq -r '.timeout // 10' <<<"$server")"
  local out="$WORK/$id.json"

  failed() { # error [locked]
    CMK_ERROR="$1" jq -nc --argjson locked "${2:-false}" '{ok: false, locked: $locked, error: $ENV.CMK_ERROR, services: []}' > "$out"
  }

  secret="$("$BIN/checkmk-config" secret "$id")"
  if [[ -z "$secret" ]]; then
    # No password at hand: not remembered, expired after its days, or locked by hand.
    # The server waits until the password is entered again.
    if [[ -n "$(jq -r '.secretFile // ""' <<<"$server")" ]]; then
      failed "Cannot read the password file $(jq -r .secretFile <<<"$server")"
    elif [[ "$(jq -r '.remember' <<<"$server")" == false ]]; then
      failed "Locked, enter the password to connect" true
    else
      failed "The remembered password expired, enter it again" true
    fi
    return
  fi

  # Livestatus filter for the services table, empty filters match everything
  query="$(jq -c '
    [ (if (.serviceFilter // "") != "" then {op: "~~", left: "description", right: .serviceFilter} else empty end),
      (if (.hostFilter // "") != "" then {op: "~~", left: "host_name", right: .hostFilter} else empty end) ]
    | if length == 0 then empty elif length == 1 then .[0] else {op: "and", expr: .} end
  ' <<<"$server")"

  local columns=(host_name description state plugin_output long_plugin_output
    last_state_change has_been_checked acknowledged scheduled_downtime_depth perf_data
    last_check check_interval cached_at cache_interval staleness
    host_state host_plugin_output host_last_state_change host_acknowledged host_scheduled_downtime_depth
    host_last_check host_check_interval host_staleness)

  local args=(-sS --max-time "$timeout" -G -w '\n%{http_code}' -H "Accept: application/json")
  [[ "$(jq -r '.insecure // false' <<<"$server")" == true ]] && args+=(-k)
  local config proxy c
  config="$(curl_option url "$url/check_mk/api/1.0/domain-types/service/collections/all")"
  for c in "${columns[@]}"; do config+=$'\n'"$(curl_option data-urlencode "columns=$c")"; done
  [[ -n "$query" ]] && config+=$'\n'"$(curl_option data-urlencode "query=$query")"
  proxy="$(jq -r '.proxy // ""' <<<"$server")"
  [[ -n "$proxy" ]] && config+=$'\n'"$(curl_option proxy "$proxy")"

  # The secret goes to curl through a file descriptor; on the command line every
  # local user could read it in /proc
  if ! response="$(curl "${args[@]}" -K <(printf '%s\n' "$config") \
    -H @<(printf 'Authorization: Bearer %s %s\n' "$user" "$secret") 2>&1)"; then
    failed "$(head -1 <<<"$response" | sed 's/^curl: ([0-9]*) //')"
    return
  fi
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$code" != 200 ]]; then
    failed "HTTP $code: $(jq -r '.title // .detail // empty' <<<"$body" 2>/dev/null || head -c 200 <<<"$body")"
    return
  fi

  # One object per service. Services that are acknowledged, in downtime or on a host
  # that is down count as handled problems. A host that is down or unreachable also
  # gets an entry of its own, service "Host".
  CMK_URL="$url" CMK_SERVER="$id" CMK_SERVER_NAME="$name" jq -c '
    $ENV.CMK_URL as $url | $ENV.CMK_SERVER as $server | $ENV.CMK_SERVER_NAME as $serverName
    | def clean: gsub("\\((!!|!|\\?)\\)"; "");
    def start($view): $url + "/check_mk/index.py?start_url=" + ($view | @uri);
    def link($h; $s): start("view.py?view_name=service&host=" + ($h | @uri) + "&service=" + ($s | @uri));
    # "load1=0.4;4;8;0; mem=41.2%;80;90" -> [{name, value, unit, warn, crit}]
    def metrics:
      [ (. // "") | splits(" +")
        | capture("^(?<name>[^=]+)=(?<value>-?[0-9.]+)(?<unit>[^;]*)(;(?<warn>[^;]*))?(;(?<crit>[^;]*))?")
        | {name: (.name | ltrimstr("'") | rtrimstr("'")), value: (.value | tonumber), unit,
           warn: (.warn // ""), crit: (.crit // "")} ];
    # When the data was produced and how often, in seconds. Local checks in a
    # subfolder such as local/300/ run asynchronously and send cached data in
    # between; only the commercial core (CMC) tells when that cache was made, the
    # Nagios core of the community edition reports 0 and the time of the last
    # agent contact instead. check_interval is in minutes (interval_length 60).
    # Checkmk itself calls a service stale from a staleness of 1.5 on.
    def timing($at; $every; $cachedAt; $cacheEvery; $staleness):
      { checked: (if ($cachedAt // 0) > 0 then $cachedAt else ($at // 0) end),
        interval: (if ($cacheEvery // 0) > 0 then $cacheEvery else (($every // 0) * 60 | round) end),
        cached: (($cachedAt // 0) > 0),
        overdue: (($staleness // 0) >= 1.5) };

    [ .value[].extensions | select(.has_been_checked == 1) ] as $rows
    | {
        ok: true,
        error: "",
        services: (
          [ $rows[] | {
              server: $server, serverName: $serverName,
              host: .host_name, service: .description, state: .state, isHost: false,
              handled: (.acknowledged == 1 or .scheduled_downtime_depth > 0 or .host_state != 0),
              output: (.plugin_output | clean),
              details: (.long_plugin_output | gsub("\\\\n"; "\n") | clean),
              metrics: (.perf_data | metrics),
              since: .last_state_change,
              link: link(.host_name; .description)
            } + timing(.last_check; .check_interval; .cached_at; .cache_interval; .staleness) ]
          + [ $rows | map(select(.host_state != 0)) | group_by(.host_name)[] | .[0] | {
              server: $server, serverName: $serverName,
              host: .host_name, service: "Host",
              # DOWN counts as CRIT, UNREACHABLE as UNKNOWN
              state: (if .host_state == 1 then 2 else 3 end), isHost: true,
              handled: (.host_acknowledged == 1 or .host_scheduled_downtime_depth > 0),
              output: ((if .host_state == 1 then "Host is DOWN" else "Host is UNREACHABLE" end) + ": " + .host_plugin_output),
              details: "", metrics: [],
              since: .host_last_state_change,
              link: start("view.py?view_name=hoststatus&host=" + (.host_name | @uri))
            } + timing(.host_last_check; .host_check_interval; 0; 0; .host_staleness) ]
        )
      }
  ' <<<"$body" > "$out" 2>/dev/null || failed "Unexpected answer from $url"
}

servers="$("$BIN/checkmk-config" list)" || servers="[]"
# Large JSON goes to jq in files: as an argument, a site with thousands of
# services exceeds the size limit of the command line
PREVIOUS="$WORK/previous.json"
jq -e . "$STATUS" > "$PREVIOUS" 2>/dev/null || echo '{}' > "$PREVIOUS"

write_status() {
  cat > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

if [[ "$(jq length <<<"$servers")" == 0 ]]; then
  jq -n '{ok: false, error: "No Checkmk server configured", unconfigured: true, checked: now | floor,
          servers: [], hosts: [], services: [], counts: {ok: 0, warn: 0, crit: 0, unknown: 0, unhandled: 0}, worst: 0}' |
    write_status
  exit 0
fi

# All servers at once, so a slow or unreachable one does not hold up the others
while IFS= read -r server; do
  fetch "$server" &
done < <(jq -c '.[]' <<<"$servers")
wait

for id in $(jq -r '.[].id' <<<"$servers"); do
  jq -c --arg id "$id" '{($id): .}' "$WORK/$id.json" 2>/dev/null ||
    jq -nc --arg id "$id" '{($id): {ok: false, error: "Poll failed", services: []}}'
done | jq -s 'add' > "$WORK/results.json"

# Merge the servers. One that failed keeps its last known services, marked stale.
printf '%s\n' "$servers" > "$WORK/servers.json"
jq -n --slurpfile servers "$WORK/servers.json" --slurpfile results "$WORK/results.json" --slurpfile previous "$PREVIOUS" '
  $servers[0] as $servers | $results[0] as $results | $previous[0] as $previous
  | def severity: if . == 2 then 3 elif . == 3 then 2 elif . == 1 then 1 else 0 end;
  def worst: max_by(severity) // 0;
  def count($state): map(select(.state == $state)) | length;
  def start($url; $view): $url + "/check_mk/index.py?start_url=" + ($view | @uri);

  [ $servers[] | . as $s | $results[$s.id] as $r
    | {id, name, url, ok: $r.ok, locked: ($r.locked // false), error: $r.error,
       services: (if $r.ok then $r.services
                  else [ ($previous.services // [])[] | select(.server == $s.id) | . + {stale: true} ] end)}
  ] as $polled
  | ([ $polled[].services[] ] | sort_by(-(.state | severity), (.isHost | not), .serverName, .host, .service)) as $services
  | ($polled | map(select(.ok | not))) as $failed
  | {
      ok: ($failed | length == 0),
      # At least one server answered
      reachable: ($failed | length < ($polled | length)),
      unconfigured: false,
      error: ($failed | map(.name + ": " + .error) | join("\n")),
      locked: ($polled | map(select(.locked)) | length > 0),
      checked: now | floor,
      # Opened by a right click on the icon
      url: $servers[0].url,
      servers: [ $polled[] | . as $p | {
          id, name, url, ok, locked, error,
          hosts: ($services | map(select(.server == $p.id) | .host) | unique | length),
          counts: ($services | map(select(.server == $p.id and (.isHost | not)))
            | {ok: count(0), warn: count(1), crit: count(2), unknown: count(3)})
        } ],
      counts: {
        ok: ($services | count(0)), warn: ($services | count(1)),
        crit: ($services | count(2)), unknown: ($services | count(3)),
        unhandled: ($services | map(select(.state != 0 and (.handled | not))) | length)
      },
      # Worst state among unhandled problems, ordered OK < WARN < UNKNOWN < CRIT
      worst: ($services | map(select(.handled | not) | .state) | worst),
      # Like the Checkmk host list: the host is as bad as its worst service, a down host is CRIT.
      # Grouped by server in the order of the server list.
      hosts: [ $polled[] | .id as $id | $services | map(select(.server == $id)) | group_by(.host)[]
        | (map(select(.isHost | not))) as $s
        | (.[0].link | sub("/check_mk/index.py.*"; "")) as $url
        | {
            server: .[0].server, serverName: .[0].serverName, host: .[0].host,
            state: (map(.state) | worst),
            down: any(.isHost),
            stale: any(.stale),
            unhandled: (map(select(.state != 0 and (.handled | not))) | length),
            counts: ($s | {ok: count(0), warn: count(1), crit: count(2), unknown: count(3)}),
            link: start($url; "view.py?view_name=host&host=" + (.[0].host | @uri))
          } ],
      services: $services
    }
' | write_status || exit 1

((notify)) || exit 0

# Fields are separated by the unit separator: read merges runs of tabs, which would
# shift every field after an empty one
SEP=$'\x1f'

# ---- Servers that became unreachable or reachable again. A server polled for the
# first time announces nothing, and neither does locking or unlocking one.
read -r down up < <(jq -r --slurpfile prev "$PREVIOUS" '
  $prev[0] as $prev
  | ($prev.servers // [] | map({key: .id, value: (if .locked then "locked" else .ok end)}) | from_entries) as $before
  | [ .servers[] | . as $s
      | select(($s.locked | not) and ($before | has($s.id)) and $before[$s.id] != "locked" and $before[$s.id] != $s.ok) ]
  | "\(map(select(.ok | not)) | length) \(map(select(.ok)) | length)"
' "$STATUS")

if ((${down:-0} == 1)); then
  send_notification normal "Checkmk: a server is unreachable" "Open the panel for details" servers
elif ((${down:-0} > 1)); then
  send_notification normal "Checkmk: $down servers are unreachable" "Open the panel for details" servers
fi
if ((${up:-0} == 1)); then
  send_notification low "Checkmk: a server is reachable again" "" servers
elif ((${up:-0} > 1)); then
  send_notification low "Checkmk: $up servers are reachable again" "" servers
fi

# ---- Services that changed state, as counts of the states they changed to.
# Services of a server that failed are stale, not changed, so they never count.
read -r count crit warn unknown ok < <(jq -r --slurpfile prev "$PREVIOUS" '
  def key: (.server // "") + "\u0000" + .host + "\u0000" + .service;
  def count($state): map(select(.state == $state)) | length;
  $prev[0] as $prev
  | ($prev.services // [] | map(select(.stale | not) | {key: key, value: .state}) | from_entries) as $before
  | [ .services[] | select((.handled | not) and (.stale | not))
      | key as $k | select(($before | has($k)) and $before[$k] != .state) ]
  | "\(length) \(count(2)) \(count(1)) \(count(3)) \(count(0))"
' "$STATUS")
((${count:-0} == 0)) && exit 0

if ((crit > 0)); then urgency=critical
elif ((warn + unknown > 0)); then urgency=normal
else urgency=low
fi

# "a service is now CRIT", or "3 services changed state" with "2 CRIT, 1 OK"
names=(OK WARN CRIT UNKNOWN)
parts=()
for state in 2 3 1 0; do
  case "$state" in 2) n=$crit ;; 3) n=$unknown ;; 1) n=$warn ;; 0) n=$ok ;; esac
  ((n > 0)) && parts+=("$n ${names[$state]}")
done
if ((count == 1)); then
  if ((ok == 1)); then headline="Checkmk: a service recovered"
  else headline="Checkmk: a service is now ${parts[0]#1 }"
  fi
  body="Open the panel for details"
else
  headline="Checkmk: $count services changed state"
  body="Now $(IFS=,; echo "${parts[*]}" | sed 's/,/, /g')"
fi
send_notification "$urgency" "$headline" "$body" problems
