#!/bin/bash
#
# Fetch service states from every configured Checkmk server, write them to a
# status file and send a desktop notification for every service that changed
# state since the previous run.
#
#   checkmk-poll              poll once
#   checkmk-poll --quiet      poll once without notifications
#
# Servers: see checkmk-config
# Output:  ${XDG_CACHE_HOME:-~/.cache}/omarchy-checkmk/status.json

set -uo pipefail
# The status file and temporary files are for this user only
umask 077

BIN="$(dirname "$(realpath "$0")")"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-checkmk"
STATUS="$STATE_DIR/status.json"

# More changes than this in a single poll are announced as one summary
MAX_NOTIFICATIONS=5

notify=1
[[ "${1:-}" == "--quiet" ]] && notify=0

mkdir -p "$STATE_DIR"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

send_notification() { # urgency headline description [url]
  ((notify)) || return 0
  local exec_args=() body="$3"
  # The body is rendered with markup and links; plugin output comes from the
  # monitored hosts and must not be able to inject either
  # (quoted, since bash 5.2 reads a bare & in the replacement as the match)
  body="${body//&/'&amp;'}"
  body="${body//</'&lt;'}"
  body="${body//>/'&gt;'}"
  [[ -n "${4:-}" ]] && exec_args=(--exec xdg-open "$4")

  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send --app-name Checkmk -g "󰗶" -u "$1" "$2" "$body" "${exec_args[@]}"
  else
    notify-send -a Checkmk -u "$1" "$2" "$body"
  fi
}

# Writes $WORK/<id>.json: {ok, error, services} with the normalised services of that server
fetch() { # server json
  local server="$1" id name url user secret timeout query response code body
  id="$(jq -r .id <<<"$server")"
  name="$(jq -r .name <<<"$server")"
  url="$(jq -r .url <<<"$server")"
  user="$(jq -r .user <<<"$server")"
  timeout="$(jq -r '.timeout // 10' <<<"$server")"
  local out="$WORK/$id.json"

  failed() {
    jq -nc --arg error "$1" '{ok: false, error: $error, services: []}' > "$out"
  }

  secret="$("$BIN/checkmk-config" secret "$id")"
  [[ -n "$secret" ]] || { failed "No password or secret stored for $user"; return; }

  # Livestatus filter for the services table, empty filters match everything
  query="$(jq -c '
    [ (if (.serviceFilter // "") != "" then {op: "~~", left: "description", right: .serviceFilter} else empty end),
      (if (.hostFilter // "") != "" then {op: "~~", left: "host_name", right: .hostFilter} else empty end) ]
    | if length == 0 then empty elif length == 1 then .[0] else {op: "and", expr: .} end
  ' <<<"$server")"

  local columns=(host_name description state plugin_output long_plugin_output
    last_state_change has_been_checked acknowledged scheduled_downtime_depth perf_data
    host_state host_plugin_output host_last_state_change host_acknowledged host_scheduled_downtime_depth)

  local args=(-sS --max-time "$timeout" -G -w '\n%{http_code}' -H "Accept: application/json")
  for c in "${columns[@]}"; do args+=(--data-urlencode "columns=$c"); done
  [[ -n "$query" ]] && args+=(--data-urlencode "query=$query")
  [[ "$(jq -r '.insecure // false' <<<"$server")" == true ]] && args+=(-k)

  # The secret goes to curl through a file descriptor; on the command line every
  # local user could read it in /proc
  if ! response="$(curl "${args[@]}" -H @<(printf 'Authorization: Bearer %s %s\n' "$user" "$secret") \
    "$url/check_mk/api/1.0/domain-types/service/collections/all" 2>&1)"; then
    failed "$(head -1 <<<"$response" | sed 's/^curl: ([0-9]*) //')"
    return
  fi
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$code" != 200 ]]; then
    failed "HTTP $code: $(jq -r '.title // .detail // empty' <<<"$body" 2>/dev/null || head -c 200 <<<"$body")"
    return
  fi

  # One object per service. Services that are acknowledged, in downtime or on a host
  # that is down count as handled problems. A host that is down or unreachable also
  # gets an entry of its own, service "Host".
  jq -c --arg url "$url" --arg server "$id" --arg serverName "$name" '
    def clean: gsub("\\((!!|!|\\?)\\)"; "");
    def start($view): $url + "/check_mk/index.py?start_url=" + ($view | @uri);
    def link($h; $s): start("view.py?view_name=service&host=" + ($h | @uri) + "&service=" + ($s | @uri));
    # "load1=0.4;4;8;0; mem=41.2%;80;90" -> [{name, value, unit, warn, crit}]
    def metrics:
      [ (. // "") | splits(" +")
        | capture("^(?<name>[^=]+)=(?<value>-?[0-9.]+)(?<unit>[^;]*)(;(?<warn>[^;]*))?(;(?<crit>[^;]*))?")
        | {name: (.name | ltrimstr("'") | rtrimstr("'")), value: (.value | tonumber), unit,
           warn: (.warn // ""), crit: (.crit // "")} ];

    [ .value[].extensions | select(.has_been_checked == 1) ] as $rows
    | {
        ok: true,
        error: "",
        services: (
          [ $rows[] | {
              server: $server, serverName: $serverName,
              host: .host_name, service: .description, state: .state, isHost: false,
              handled: (.acknowledged == 1 or .scheduled_downtime_depth > 0 or .host_state != 0),
              output: (.plugin_output | clean),
              details: (.long_plugin_output | gsub("\\\\n"; "\n") | clean),
              metrics: (.perf_data | metrics),
              since: .last_state_change,
              link: link(.host_name; .description)
            } ]
          + [ $rows | map(select(.host_state != 0)) | group_by(.host_name)[] | .[0] | {
              server: $server, serverName: $serverName,
              host: .host_name, service: "Host",
              # DOWN counts as CRIT, UNREACHABLE as UNKNOWN
              state: (if .host_state == 1 then 2 else 3 end), isHost: true,
              handled: (.host_acknowledged == 1 or .host_scheduled_downtime_depth > 0),
              output: ((if .host_state == 1 then "Host is DOWN" else "Host is UNREACHABLE" end) + ": " + .host_plugin_output),
              details: "", metrics: [],
              since: .host_last_state_change,
              link: start("view.py?view_name=hoststatus&host=" + (.host_name | @uri))
            } ]
        )
      }
  ' <<<"$body" > "$out" 2>/dev/null || failed "Unexpected answer from $url"
}

servers="$("$BIN/checkmk-config" list)" || servers="[]"
previous="$(cat "$STATUS" 2>/dev/null)"
jq -e . >/dev/null 2>&1 <<<"$previous" || previous='{}'

write_status() {
  cat > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

if [[ "$(jq length <<<"$servers")" == 0 ]]; then
  jq -n '{ok: false, error: "No Checkmk server configured", unconfigured: true, checked: now | floor,
          servers: [], hosts: [], services: [], counts: {ok: 0, warn: 0, crit: 0, unknown: 0, unhandled: 0}, worst: 0}' |
    write_status
  exit 0
fi

# All servers at once, so a slow or unreachable one does not hold up the others
while IFS= read -r server; do
  fetch "$server" &
done < <(jq -c '.[]' <<<"$servers")
wait

results="$(for id in $(jq -r '.[].id' <<<"$servers"); do
  jq -c --arg id "$id" '{($id): .}' "$WORK/$id.json" 2>/dev/null ||
    jq -nc --arg id "$id" '{($id): {ok: false, error: "Poll failed", services: []}}'
done | jq -s 'add')"

# Merge the servers. One that failed keeps its last known services, marked stale.
jq -n --argjson servers "$servers" --argjson results "$results" --argjson previous "$previous" '
  def severity: if . == 2 then 3 elif . == 3 then 2 elif . == 1 then 1 else 0 end;
  def worst: max_by(severity) // 0;
  def count($state): map(select(.state == $state)) | length;
  def start($url; $view): $url + "/check_mk/index.py?start_url=" + ($view | @uri);

  [ $servers[] | . as $s | $results[$s.id] as $r
    | {id, name, url, ok: $r.ok, error: $r.error,
       services: (if $r.ok then $r.services
                  else [ ($previous.services // [])[] | select(.server == $s.id) | . + {stale: true} ] end)}
  ] as $polled
  | ([ $polled[].services[] ] | sort_by(-(.state | severity), (.isHost | not), .serverName, .host, .service)) as $services
  | ($polled | map(select(.ok | not))) as $failed
  | {
      ok: ($failed | length == 0),
      # At least one server answered
      reachable: ($failed | length < ($polled | length)),
      unconfigured: false,
      error: ($failed | map(.name + ": " + .error) | join("\n")),
      checked: now | floor,
      # Opened by a right click on the icon
      url: $servers[0].url,
      servers: [ $polled[] | . as $p | {
          id, name, url, ok, error,
          hosts: ($services | map(select(.server == $p.id) | .host) | unique | length),
          counts: ($services | map(select(.server == $p.id and (.isHost | not)))
            | {ok: count(0), warn: count(1), crit: count(2), unknown: count(3)})
        } ],
      counts: {
        ok: ($services | count(0)), warn: ($services | count(1)),
        crit: ($services | count(2)), unknown: ($services | count(3)),
        unhandled: ($services | map(select(.state != 0 and (.handled | not))) | length)
      },
      # Worst state among unhandled problems, ordered OK < WARN < UNKNOWN < CRIT
      worst: ($services | map(select(.handled | not) | .state) | worst),
      # Like the Checkmk host list: the host is as bad as its worst service, a down host is CRIT.
      # Grouped by server in the order of the server list.
      hosts: [ $polled[] | .id as $id | $services | map(select(.server == $id)) | group_by(.host)[]
        | (map(select(.isHost | not))) as $s
        | (.[0].link | sub("/check_mk/index.py.*"; "")) as $url
        | {
            server: .[0].server, serverName: .[0].serverName, host: .[0].host,
            state: (map(.state) | worst),
            down: any(.isHost),
            stale: any(.stale),
            unhandled: (map(select(.state != 0 and (.handled | not))) | length),
            counts: ($s | {ok: count(0), warn: count(1), crit: count(2), unknown: count(3)}),
            link: start($url; "view.py?view_name=host&host=" + (.[0].host | @uri))
          } ],
      services: $services
    }
' | write_status || exit 1

((notify)) || exit 0

# Fields are separated by the unit separator: read merges runs of tabs, which would
# shift every field after an empty one
SEP=$'\x1f'

# ---- Servers that became unreachable or reachable again. A server polled for the
# first time announces nothing.
while IFS="$SEP" read -r kind name detail url; do
  if [[ "$kind" == down ]]; then
    send_notification normal "Checkmk $name unreachable" "$detail"
  else
    send_notification low "Checkmk $name reachable again" "$url"
  fi
done < <(jq -r --argjson prev "$previous" '
  ($prev.servers // [] | map({key: .id, value: .ok}) | from_entries) as $before
  | .servers[] | . as $s | select(($before | has($s.id)) and $before[$s.id] != $s.ok)
  | [(if $s.ok then "up" else "down" end), $s.name, $s.error, $s.url] | join("\u001f")
' "$STATUS")

# ---- Services that changed state. Services of a server that failed are stale, not
# changed, so they never show up here.
changes="$(jq -c --argjson prev "$previous" '
  def key: (.server // "") + "\u0000" + .host + "\u0000" + .service;
  ($prev.services // [] | map(select(.stale | not) | {key: key, value: .state}) | from_entries) as $before
  | [ .services[] | select((.handled | not) and (.stale | not))
      | key as $k | select(($before | has($k)) and $before[$k] != .state) | . + {before: $before[$k]} ]
' "$STATUS")"

count="$(jq length <<<"$changes")"
((count == 0)) && exit 0

names=(OK WARN CRIT UNKNOWN)
multi="$(jq '.servers | length > 1' "$STATUS")"

if ((count > MAX_NOTIFICATIONS)); then
  summary="$(jq -r '.counts | "\(.crit) CRIT, \(.warn) WARN, \(.unknown) UNKNOWN"' "$STATUS")"
  send_notification critical "Checkmk: $count services changed state" "Now $summary" "$(jq -r .url "$STATUS")/check_mk/"
  exit 0
fi

while IFS="$SEP" read -r state before host serverName service output link; do
  case "$state" in
    2) urgency=critical ;;
    0) urgency=low ;;
    *) urgency=normal ;;
  esac
  where="$host"
  [[ "$multi" == true ]] && where="$host · $serverName"
  send_notification "$urgency" "${names[$state]}  $service" "$where (was ${names[$before]})"$'\n'"$output" "$link"
done < <(jq -r '.[] | [.state, .before, .host, .serverName, .service, .output, .link] | map(tostring) | join("\u001f")' <<<"$changes")
