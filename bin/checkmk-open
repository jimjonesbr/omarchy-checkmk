#!/bin/bash
#
# Open a Checkmk link in the default browser.
#
#   echo <url> | checkmk-open
#
# Links name hosts and services, so neither this script nor the browser gets
# them on the command line, where every local user could read them in /proc.
# The link arrives on stdin, and the browser is given a page in a private
# directory that forwards to it.

set -uo pipefail
umask 077

IFS= read -r url || true
[[ "$url" =~ ^https?:// ]] || { echo "usage: echo <http(s) url> | checkmk-open" >&2; exit 2; }

# The runtime directory is in memory and for this user only
PAGES="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/omarchy-checkmk"
mkdir -p "$PAGES" && chmod 700 "$PAGES"
# Pages of earlier links are no longer needed
find "$PAGES" -maxdepth 1 -name 'open-*.html' -mmin +1 -delete 2>/dev/null
page="$(mktemp "$PAGES/open-XXXXXXXX.html")" || exit 1

# (quoted, since bash 5.2 reads a bare & in the replacement as the match)
html="${url//&/'&amp;'}"
html="${html//\"/'&quot;'}"
html="${html//</'&lt;'}"
html="${html//>/'&gt;'}"
cat > "$page" <<EOF
<!doctype html>
<meta charset="utf-8">
<meta name="referrer" content="no-referrer">
<meta http-equiv="refresh" content="0;url=$html">
<title>Checkmk</title>
<a href="$html">Open Checkmk</a>
EOF
# Gone once the browser has read it
setsid -f sh -c 'sleep 60; rm -f "$1"' sh "$page" >/dev/null 2>&1

setsid -f xdg-open "$page" >/dev/null 2>&1
