#!/bin/bash
#
# Manage the Checkmk servers watched by checkmk-poll.
#
#   checkmk-config list           print all servers as JSON (never the secrets)
#   checkmk-config test           test a server read as JSON from stdin
#   checkmk-config save           add or update a server read as JSON from stdin
#   checkmk-config delete <id>    remove a server and its stored secret
#   checkmk-config unlock <id>    check a secret read as JSON from stdin, {"secret": "..."},
#                                 and keep it again, for a locked server
#   checkmk-config lock [<id>]    forget the secret of one or all servers
#   checkmk-config disconnect <id>  stop polling a server, keeping its settings and a
#                                 remembered secret; a secret only in memory is forgotten
#   checkmk-config connect <id>   poll a disconnected server again, {"needsSecret": true}
#                                 when its secret has to be entered first
#   checkmk-config secret <id>    print the secret of a server, for checkmk-poll
#
# test and save read one line of JSON from stdin:
#   {"id": "", "name": "Production", "url": "...", "user": "...", "secret": "...",
#    "serviceFilter": "", "hostFilter": "", "insecure": false, "remember": false,
#    "proxy": "", "muted": false}
# An empty id adds a server, an empty secret keeps the stored one as long as URL
# and user stay the same; for another URL or user it has to be entered. Without
# "remember", a new server does not remember its secret and an existing one keeps
# its choice. A "muted" server sends no notifications. Saving keeps whether a
# server is "disconnected"; only disconnect and connect change that, so that a
# server can be disconnected without its secret at hand.
#
# The servers are kept in ~/.config/omarchy-checkmk/servers.json. A secret is kept
# in one of two ways:
#
# - Not remembered ("remember": false, the default for new servers): never written
#   anywhere. After each login the server is locked; the secret entered then lives
#   in the kernel keyring of the user (memory only) for "sessionHours" (default 8).
# - Remembered ("remember": true, or no "remember" in servers.json from before it
#   existed): in the desktop keyring (Secret Service, e.g. gnome-keyring), or where
#   there is none in secrets/<id>, readable by the user alone. Note that a keyring
#   without a password of its own, as with autologin, is a plain file on disk.
#   The secret is deleted after "rememberDays" (default 30, "rememberedUntil" holds
#   the date) and the server is locked until it is entered again.
#
# Settings and secrets never go on a command line, where every local user could
# read them in /proc: jq gets them through the environment or stdin, curl through
# its config stream. secret-tool takes the attributes of a keyring entry only as
# arguments, so entries are filed under a salted hash of URL and user.
#
# A server may also name a "secretFile" of its own, e.g. for the test instance;
# that file is never expired or deleted.
#
# A server on a network that is only reachable through a tunnel names a "proxy"
# for curl, e.g. "socks5h://127.0.0.1:1080" for `ssh -D 1080 jumphost`; a bare
# host:port means SOCKS5 with the host names resolved through the tunnel.

set -uo pipefail
# servers.json and secret files are for this user only
umask 077

DIR="${CHECKMK_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-checkmk}"
SERVERS="$DIR/servers.json"
SECRETS="$DIR/secrets"
SALT="$DIR/keyring-salt"
KEYRING_MIGRATED="$DIR/keyring-migrated"
SESSION_HOURS=8
REMEMBER_DAYS=30
# Single server configuration of earlier versions, migrated on first use
LEGACY="$DIR/config"

# One run at a time: the poller, the graphs and the panel all call this, and
# two runs writing servers.json at once could leave half of one in it
mkdir -p "$DIR"
if command -v flock >/dev/null; then
  exec 9>"$DIR/.lock"
  flock -w 30 9 || { echo '{"ok": false, "message": "Another change to the servers is still running"}'; exit 1; }
fi

servers() {
  jq -c '.servers // []' "$SERVERS" 2>/dev/null || echo '[]'
}

write_servers() { # json array on stdin
  local tmp
  tmp="$(mktemp "$SERVERS.XXXXXX")" || return 1
  if jq '{servers: .}' > "$tmp"; then mv "$tmp" "$SERVERS"; else rm -f "$tmp"; return 1; fi
}

server() { # id
  servers | jq -c --arg id "$1" '.[] | select(.id == $id)'
}

# Accept whatever the user copied from the browser, e.g. https://host/site/check_mk/index.py
normalize_url() {
  local url="${1%%/check_mk*}"
  echo "${url%/}"
}

# "https://monitoring.example.com/prod" -> "monitoring.example.com/prod"
name_from_url() {
  local name="${1#*://}"
  echo "${name%/}"
}

# Lowercase letters, digits and dashes, unique among the servers
new_id() { # name
  local base id n=1
  base="$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')"
  base="${base:-server}"
  id="$base"
  while [[ -n "$(server "$id")" ]]; do
    n=$((n + 1))
    id="$base-$n"
  done
  echo "$id"
}

keyring_available() {
  command -v secret-tool >/dev/null
}

# A keyring entry is filed under a key made from url and user, so that two
# servers with the same url and user share it. secret-tool takes attributes
# only on its command line, where every local user could read them, so the key
# is a hash, salted with a random value of this user's to make it impossible to
# check guesses of the url against it.
keyring_key() { # url user
  if [[ ! -s "$SALT" ]]; then
    mkdir -p "$DIR"
    local tmp
    tmp="$(mktemp "$SALT.XXXXXX")" && head -c 32 /dev/urandom | base64 > "$tmp" && mv "$tmp" "$SALT"
  fi
  { cat "$SALT"; printf '%s\n%s' "$1" "$2"; } | sha256sum | cut -d' ' -f1
}

keyring_lookup() { # url user
  keyring_available && secret-tool lookup application omarchy-checkmk key "$(keyring_key "$1" "$2")" 2>/dev/null
}

keyring_store() { # url user secret
  keyring_available || return 1
  printf '%s' "$3" | secret-tool store --label "Checkmk password (Omarchy widget)" \
    application omarchy-checkmk key "$(keyring_key "$1" "$2")" 2>/dev/null
}

keyring_clear() { # url user
  keyring_available && secret-tool clear application omarchy-checkmk key "$(keyring_key "$1" "$2")" 2>/dev/null
  return 0
}

# Removes the entry of url and user unless another server still remembers it
keyring_clear_unused() { # url user
  local users
  users="$(servers | CMK_U="$1" CMK_N="$2" jq '$ENV.CMK_U as $u | $ENV.CMK_N as $n
    | [.[] | select(.url == $u and .user == $n and .remember != false)] | length')"
  ((users == 0)) && keyring_clear "$1" "$2"
  return 0
}

# Up to 0.4.0-beta.1 entries were filed under the plain url and user. They move
# to their hashed key once; the marker keeps the old lookups from running again.
migrate_keyring() {
  [[ -e "$KEYRING_MIGRATED" ]] && return 0
  keyring_available || return 0
  local s url user secret
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    url="$(jq -r .url <<<"$s")"
    user="$(jq -r .user <<<"$s")"
    secret="$(secret-tool lookup application omarchy-checkmk url "$url" user "$user" 2>/dev/null)"
    [[ -n "$secret" ]] || continue
    keyring_store "$url" "$user" "$secret" &&
      secret-tool clear application omarchy-checkmk url "$url" user "$user" 2>/dev/null
  done < <(servers | jq -c 'unique_by([.url, .user])[] | select(.remember != false and (.secretFile // "") == "")')
  [[ -e "$SERVERS" ]] && touch "$KEYRING_MIGRATED"
  return 0
}

# ---- Secrets kept in memory, in the kernel keyring of the user

session_key() { # id -> kernel key serial
  keyctl search @u user "omarchy-checkmk:$1" 2>/dev/null
}

session_lookup() { # id
  local key
  key="$(session_key "$1")" && keyctl pipe "$key" 2>/dev/null
}

session_store() { # id secret hours
  command -v keyctl >/dev/null || return 1
  local key
  # padd reads the secret from stdin and replaces an existing key of the same name
  key="$(printf '%s' "$2" | keyctl padd user "omarchy-checkmk:$1" @u 2>/dev/null)" || return 1
  # Readable by this user's processes, like the desktop keyring
  keyctl setperm "$key" 0x3f3f0000 >/dev/null 2>&1
  keyctl timeout "$key" $(($3 * 3600)) >/dev/null
}

session_clear() { # id
  local key
  key="$(session_key "$1")" || return 0
  keyctl revoke "$key" >/dev/null 2>&1
  keyctl unlink "$key" @u >/dev/null 2>&1
  return 0
}

# Time left of an unlocked secret as the kernel reports it, e.g. "7h59m"
session_expires() { # id
  local key
  key="$(session_key "$1")" || return 0
  awk -v id="$(printf '%08x' "$key")" '$1 == id { print $4 }' /proc/keys 2>/dev/null
}

secret_of() { # server json
  local id url user file
  id="$(jq -r .id <<<"$1")"
  if [[ "$(jq -r '.remember' <<<"$1")" == false ]]; then
    session_lookup "$id"
    return
  fi
  url="$(jq -r .url <<<"$1")"
  user="$(jq -r .user <<<"$1")"
  file="$(jq -r '.secretFile // ""' <<<"$1")"

  if [[ -n "$file" ]]; then
    cat "${file/#\~/$HOME}" 2>/dev/null
  elif [[ -r "$SECRETS/$id" ]]; then
    cat "$SECRETS/$id"
  else
    keyring_lookup "$url" "$user"
  fi
}

secret_store_of() { # server json
  local id
  id="$(jq -r .id <<<"$1")"
  if [[ "$(jq -r '.remember' <<<"$1")" == false ]]; then echo session
  elif [[ -n "$(jq -r '.secretFile // ""' <<<"$1")" ]]; then echo file
  elif [[ -r "$SECRETS/$id" ]]; then echo file
  elif keyring_lookup "$(jq -r .url <<<"$1")" "$(jq -r .user <<<"$1")" >/dev/null; then echo keyring
  else echo none
  fi
}

store_secret() { # id url user secret -> prints the store used
  if keyring_store "$2" "$3" "$4"; then
    rm -f "$SECRETS/$1"
    echo keyring
  else
    mkdir -p "$SECRETS"
    chmod 700 "$SECRETS"
    (umask 077; printf '%s\n' "$4" > "$SECRETS/$1")
    echo file
  fi
}

remember_days() { # server json
  jq -r --argjson d "$REMEMBER_DAYS" '.rememberDays // $d' <<<"$1"
}

set_remembered_until() { # id epoch, 0 removes it
  servers | jq --arg id "$1" --argjson until "$2" '
    map(if .id == $id then (if $until > 0 then .rememberedUntil = $until else del(.rememberedUntil) end) else . end)
  ' | write_servers
}

forget_secret() { # server json
  local id
  id="$(jq -r .id <<<"$1")"
  rm -f "$SECRETS/$id"
  session_clear "$id"
  keyring_clear "$(jq -r .url <<<"$1")" "$(jq -r .user <<<"$1")"
  set_remembered_until "$id" 0
}

# Remembered secrets past their date are deleted. Secrets remembered before there
# was an expiry get their 30 days from now on.
expire_secrets() {
  local now s id until
  now="$(date +%s)"
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    id="$(jq -r .id <<<"$s")"
    until="$(jq -r '.rememberedUntil // 0' <<<"$s")"
    if ((until == 0)); then
      [[ "$(secret_store_of "$s")" != none ]] && set_remembered_until "$id" $((now + $(remember_days "$s") * 86400))
    elif ((until <= now)); then
      forget_secret "$s"
    fi
  done < <(servers | jq -c '.[] | select(.remember != false and (.secretFile // "") == "")')
}

# The value of NAME="value" in the config of 0.2.0, read as text: the file is
# never run, so nothing written into it can execute
legacy_value() { # name
  local line value
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$1=" "$LEGACY" | tail -1)"
  value="${line#*=}"
  if [[ "$value" =~ ^\"(.*)\"[[:space:]]*$ || "$value" =~ ^\'(.*)\'[[:space:]]*$ ]]; then
    value="${BASH_REMATCH[1]}"
  fi
  printf '%s' "$value"
}

migrate_legacy() {
  [[ -r "$LEGACY" && ! -e "$SERVERS" ]] || return 0

  local CMK_URL CMK_USER CMK_SECRET CMK_SECRET_FILE CMK_SERVICE_FILTER CMK_HOST_FILTER CMK_INSECURE CMK_TIMEOUT
  CMK_URL="$(normalize_url "$(legacy_value CMK_URL)")"
  CMK_USER="$(legacy_value CMK_USER)"
  CMK_SECRET="$(legacy_value CMK_SECRET)"
  CMK_SECRET_FILE="$(legacy_value CMK_SECRET_FILE)"
  CMK_SERVICE_FILTER="$(legacy_value CMK_SERVICE_FILTER)"
  CMK_HOST_FILTER="$(legacy_value CMK_HOST_FILTER)"
  CMK_INSECURE="$(legacy_value CMK_INSECURE)"
  CMK_TIMEOUT="$(legacy_value CMK_TIMEOUT)"
  [[ "$CMK_TIMEOUT" =~ ^[0-9]+$ ]] || CMK_TIMEOUT=""

  local id
  id="$(new_id "$(name_from_url "$CMK_URL")")"
  J_NAME="$(name_from_url "$CMK_URL")" J_URL="$CMK_URL" J_USER="$CMK_USER" \
    J_SF="$CMK_SERVICE_FILTER" J_HF="$CMK_HOST_FILTER" J_FILE="$CMK_SECRET_FILE" \
    jq -n --arg id "$id" --argjson insecure "$([[ "$CMK_INSECURE" == 1 ]] && echo true || echo false)" \
    --arg timeout "$CMK_TIMEOUT" '
    $ENV.J_NAME as $name | $ENV.J_URL as $url | $ENV.J_USER as $user
    | $ENV.J_SF as $sf | $ENV.J_HF as $hf | $ENV.J_FILE as $file
    | [{id: $id, name: $name, url: $url, user: $user, serviceFilter: $sf, hostFilter: $hf, insecure: $insecure}
      + (if $file != "" then {secretFile: $file} else {} end)
      + (if $timeout != "" then {timeout: ($timeout | tonumber)} else {} end)]
  ' | write_servers

  # A secret written into the old config moves to the keyring and out of the file
  if [[ -n "$CMK_SECRET" ]]; then
    store_secret "$id" "$CMK_URL" "$CMK_USER" "$CMK_SECRET" >/dev/null
    sed -i '/^[[:space:]]*CMK_SECRET=/d' "$LEGACY"
  fi
  mv "$LEGACY" "$LEGACY.migrated"
}

list() {
  local out="[]" s
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    local id expires=""
    id="$(jq -r .id <<<"$s")"
    [[ "$(jq -r '.remember' <<<"$s")" == false ]] && expires="$(session_expires "$id")"
    out="$(J_S="$s" jq -c --arg store "$(secret_store_of "$s")" --arg expires "$expires" --argjson now "$(date +%s)" '
      ($ENV.J_S | fromjson) as $s
      | . + [$s + {secretStore: $store}
            + if $store == "session" then {unlocked: ($expires != ""), expires: $expires}
              elif ($s.rememberedUntil // 0) > 0 and ($s.secretFile // "") == "" then
                {unlocked: true, expires: ((($s.rememberedUntil - $now) / 86400 | ceil | tostring) + "d")}
              elif $store == "none" then {unlocked: false, expires: ""}
              else {} end]
    ' <<<"$out")"
  done < <(servers | jq -c '.[]')
  echo "$out"
}

# A bare host:port is a SOCKS5 proxy that also resolves the host names, as
# `ssh -D` provides
normalize_proxy() { # proxy
  local p
  p="$(sed 's/^ *//; s/ *$//' <<<"$1")"
  [[ -z "$p" || "$p" == *://* ]] || p="socks5h://$p"
  echo "$p"
}

valid_proxy() { # proxy
  [[ -z "$1" || "$1" =~ ^(socks5h|socks5|socks4a|socks4|http|https)://[^[:space:]/]+/?$ ]]
}

# One line of a curl config: the value quoted, with \ and " escaped and line
# breaks encoded, so that no value can start an option line of its own
curl_option() { # name value
  local v="${2//\\/\\\\}"
  v="${v//\"/\\\"}"
  v="${v//$'\n'/\\n}"
  printf '%s = "%s"\n' "$1" "${v//$'\r'/\\r}"
}

# curl config for a request to IN_URL with IN_INSECURE and IN_PROXY. It goes to
# curl with -K through a file descriptor: on the command line every local user
# could read the site URL in /proc.
connection_config() { # path below the site URL
  echo 'proto = "=http,https"'
  curl_option url "$IN_URL$1"
  [[ "$IN_INSECURE" == true ]] && echo insecure
  [[ -n "$IN_PROXY" ]] && curl_option proxy "$IN_PROXY"
  return 0
}

result() { # ok message [extra json]
  local extra="${3:-}"
  J_MESSAGE="$2" J_EXTRA="${extra:-null}" jq -nc --argjson ok "$1" \
    '{ok: $ok, message: $ENV.J_MESSAGE} + ($ENV.J_EXTRA | fromjson // {})'
}

read_input() {
  local line
  IFS= read -r line || true
  jq -e . >/dev/null 2>&1 <<<"$line" || { result false "Invalid input"; exit 1; }
  IN_ID="$(jq -r '.id // ""' <<<"$line")"
  IN_NAME="$(jq -r '.name // ""' <<<"$line" | sed 's/^ *//; s/ *$//')"
  IN_URL="$(normalize_url "$(jq -r '.url // ""' <<<"$line")")"
  IN_USER="$(jq -r '.user // ""' <<<"$line")"
  IN_SECRET="$(jq -r '.secret // ""' <<<"$line")"
  IN_SERVICE_FILTER="$(jq -r '.serviceFilter // ""' <<<"$line")"
  IN_HOST_FILTER="$(jq -r '.hostFilter // ""' <<<"$line")"
  IN_INSECURE="$(jq -r 'if .insecure then true else false end' <<<"$line")"
  IN_PROXY="$(normalize_proxy "$(jq -r '.proxy // ""' <<<"$line")")"
  IN_MUTED="$(jq -r 'if .muted then true else false end' <<<"$line")"

  EXISTING=""
  [[ -n "$IN_ID" ]] && EXISTING="$(server "$IN_ID")"
  IN_REMEMBER="$(J_E="${EXISTING:-null}" jq -r '
    ($ENV.J_E | fromjson) as $e
    | if .remember != null then .remember == true
    elif $e != null then $e.remember != false
    else false end' <<<"$line")"
  # An empty secret keeps the stored one, but only for the same site and user:
  # the secret of one site must never go to another, not even for a test
  IN_SITE_CHANGED=false
  if [[ -z "$IN_SECRET" && -n "$EXISTING" ]]; then
    if [[ "$IN_URL" == "$(jq -r .url <<<"$EXISTING")" && "$IN_USER" == "$(jq -r .user <<<"$EXISTING")" ]]; then
      IN_SECRET="$(secret_of "$EXISTING")"
    else
      IN_SITE_CHANGED=true
    fi
  fi
}

# For an empty secret: why it has to be entered
missing_secret() {
  if [[ "${IN_SITE_CHANGED:-false}" == true ]]; then
    result false "Enter the password or secret: the URL or user changed, and a stored one only goes to its own site"
  else
    result false "The password or secret is missing"
  fi
}

# Setups that work but expose more than they need to, as a JSON array of texts
warnings() {
  local list=() host
  host="$(sed -E 's#^[a-z]+://([^/:]+).*#\1#' <<<"$IN_URL")"
  if [[ "$IN_URL" == http://* && ! "$host" =~ ^(localhost|127\.[0-9.]+|\[?::1\]?)$ ]]; then
    list+=("Plain http: the secret crosses the network unencrypted. Use https.")
  fi
  if [[ "$IN_INSECURE" == true ]]; then
    list+=("Certificate checks are off: anyone on the way could pose as this server and receive the secret.")
  fi
  # Only accounts with access to the Checkmk configuration may list pending changes
  local args=(-s -o /dev/null --max-time 10 -w '%{http_code}' -H "Accept: application/json")
  if [[ "$(curl "${args[@]}" -K <(connection_config /check_mk/api/1.0/domain-types/activation_run/collections/pending_changes) \
    -H @<(printf 'Authorization: Bearer %s %s\n' "$IN_USER" "$IN_SECRET"))" == 200 ]]; then
    list+=("This account can change the Checkmk configuration. The widget only reads; a user with the role Guest user is enough and safer to keep on a laptop.")
  fi
  printf '%s\n' "${list[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))'
}

test_connection() {
  read_input
  check_connection
}

# The input that may reach curl: a URL of the web, and a user name and secret on
# one line each, since they go into a header
check_input() {
  [[ "$IN_URL" =~ ^https?://[^[:space:]]+$ ]] ||
    { result false "The URL must start with https:// (or http://)"; return 1; }
  valid_proxy "$IN_PROXY" ||
    { result false "The proxy must look like socks5h://127.0.0.1:1080 or http://proxy:3128"; return 1; }
  [[ "$IN_USER$IN_SECRET" != *[$'\r\n']* ]] ||
    { result false "The user name and the password or secret must not contain line breaks"; return 1; }
}

# Tests IN_URL, IN_USER, IN_SECRET, IN_INSECURE and IN_PROXY and prints the result
check_connection() {
  [[ -n "$IN_URL" ]] || { result false "The URL is missing"; return 1; }
  [[ -n "$IN_USER" ]] || { result false "The user name is missing"; return 1; }
  [[ -n "$IN_SECRET" ]] || { missing_secret; return 1; }
  check_input || return 1

  local args=(-sS --max-time 10 -w '\n%{http_code}' -H "Accept: application/json")

  local response code body version
  # The secret goes to curl through a file descriptor, never on its command line
  if ! response="$(curl "${args[@]}" -K <(connection_config /check_mk/api/1.0/version) \
    -H @<(printf 'Authorization: Bearer %s %s\n' "$IN_USER" "$IN_SECRET") 2>&1)"; then
    result false "$(head -1 <<<"$response" | sed 's/^curl: ([0-9]*) //')"
    return 1
  fi
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"

  case "$code" in
    200)
      version="$(jq -r '.versions.checkmk // empty' <<<"$body" 2>/dev/null)"
      if [[ -z "$version" ]]; then
        result false "Answered, but this does not look like a Checkmk site. Use the site URL, e.g. https://monitoring.example.com/mysite"
        return 1
      fi
      result true "Connected to Checkmk $version" \
        "$(jq -nc --arg v "$version" --argjson w "$(warnings)" '{version: $v, warnings: $w}')"
      ;;
    401|403) result false "Checkmk rejected the user name or secret (HTTP $code)"; return 1 ;;
    404) result false "No Checkmk REST API at this URL (HTTP 404). Use the site URL, e.g. https://monitoring.example.com/mysite"; return 1 ;;
    *) result false "Unexpected answer from Checkmk (HTTP $code)"; return 1 ;;
  esac
}

save() {
  read_input
  [[ -n "$IN_URL" && -n "$IN_USER" ]] || { result false "URL and user name are required"; return 1; }
  [[ -n "$IN_SECRET" ]] || { missing_secret; return 1; }
  check_input || return 1
  [[ -n "$IN_ID" && -z "$EXISTING" ]] && { result false "Unknown server $IN_ID"; return 1; }

  local name="${IN_NAME:-$(name_from_url "$IN_URL")}" id="$IN_ID" old_url="" old_user="" store
  if [[ -z "$id" ]]; then
    id="$(new_id "$name")"
  else
    old_url="$(jq -r .url <<<"$EXISTING")"
    old_user="$(jq -r .user <<<"$EXISTING")"
  fi

  local secret_file="" hours="$SESSION_HOURS"
  [[ -n "$EXISTING" ]] && secret_file="$(jq -r '.secretFile // ""' <<<"$EXISTING")"
  [[ -n "$EXISTING" ]] && hours="$(jq -r --argjson d "$SESSION_HOURS" '.sessionHours // $d' <<<"$EXISTING")"
  if [[ "$IN_REMEMBER" == false ]]; then
    # Nothing on disk: the secret only unlocks the server for this session
    secret_file=""
    session_store "$id" "$IN_SECRET" "$hours" ||
      { result false "Could not keep the secret in memory: keyctl (package keyutils) is missing"; return 1; }
    rm -f "$SECRETS/$id"
    store=session
  elif [[ -n "$secret_file" && "$IN_SECRET" == "$(secret_of "$EXISTING")" ]]; then
    # A secret file of the server's own stays in charge, unless a new secret was typed in
    store=file
  else
    secret_file=""
    store="$(store_secret "$id" "$IN_URL" "$IN_USER" "$IN_SECRET")"
    session_clear "$id"
  fi
  local days=$REMEMBER_DAYS until=0
  [[ -n "$EXISTING" ]] && days="$(remember_days "$EXISTING")"
  [[ "$IN_REMEMBER" == true && -z "$secret_file" ]] && until=$(($(date +%s) + days * 86400))

  servers | J_NAME="$name" J_URL="$IN_URL" J_USER="$IN_USER" J_SF="$IN_SERVICE_FILTER" \
    J_HF="$IN_HOST_FILTER" J_FILE="$secret_file" J_PROXY="$IN_PROXY" \
    jq --arg id "$id" --argjson insecure "$IN_INSECURE" --argjson remember "$IN_REMEMBER" --argjson until "$until" \
    --argjson muted "$IN_MUTED" '
    $ENV.J_NAME as $name | $ENV.J_URL as $url | $ENV.J_USER as $user | $ENV.J_SF as $sf
    | $ENV.J_HF as $hf | $ENV.J_FILE as $file | $ENV.J_PROXY as $proxy
    | ({id: $id, name: $name, url: $url, user: $user, serviceFilter: $sf, hostFilter: $hf, insecure: $insecure}
      + (if $proxy != "" then {proxy: $proxy} else {} end)
      + (if $file != "" then {secretFile: $file} else {} end)
      + {remember: $remember}
      + (if $muted then {muted: true} else {} end)
      + (if $until > 0 then {rememberedUntil: $until} else {} end)) as $new
    | if any(.[]; .id == $id)
      then map(if .id == $id
        then (with_entries(select(.key | IN("timeout", "site", "sessionHours", "rememberDays", "disconnected"))) + $new)
        else . end)
      else . + [$new] end
  ' | write_servers

  # A secret no longer needed in the desktop keyring is removed from it
  # Only a server that remembered its secret can have left one there
  if [[ -n "$EXISTING" && "$(jq -r '.remember' <<<"$EXISTING")" != false ]]; then
    keyring_clear_unused "$old_url" "$old_user"
    [[ "$IN_REMEMBER" == false ]] && keyring_clear_unused "$IN_URL" "$IN_USER"
  fi

  local where
  case "$store" in
    keyring) where="password remembered for $days days" ;;
    session) where="password kept in memory for $hours hours, never saved" ;;
    *) where="password saved for $days days in a file only you can read: there is no desktop keyring" ;;
  esac
  [[ -n "$secret_file" ]] && where="password read from $secret_file"
  result true "Saved $name, $where" \
    "$(jq -nc --arg id "$id" --arg s "$store" --argjson w "$(warnings)" '{id: $id, secretStore: $s, warnings: $w}')"
}

delete() { # id
  local existing
  existing="$(server "$1")"
  [[ -n "$existing" ]] || { result false "Unknown server $1"; return 1; }
  servers | jq --arg id "$1" 'map(select(.id != $id))' | write_servers
  rm -f "$SECRETS/$1"
  session_clear "$1"
  [[ "$(jq -r '.remember' <<<"$existing")" != false ]] &&
    keyring_clear_unused "$(jq -r .url <<<"$existing")" "$(jq -r .user <<<"$existing")"
  result true "Removed $(jq -r .name <<<"$existing")"
}

# Disconnected servers are not polled. Their settings stay, and so does a
# remembered secret: remembering it was the choice. A secret kept in memory only
# is there for polling and goes, as with lock.
set_disconnected() { # id true|false
  local existing
  existing="$(server "$1")"
  [[ -n "$existing" ]] || { result false "Unknown server $1"; return 1; }
  servers | jq --arg id "$1" --argjson off "$2" '
    map(if .id == $id then (if $off then .disconnected = true else del(.disconnected) end) else . end)
  ' | write_servers
  if [[ "$2" == true ]]; then
    [[ "$(jq -r '.remember' <<<"$existing")" == false ]] && session_clear "$1"
    result true "Disconnected"
  elif [[ -z "$(secret_of "$existing")" ]]; then
    result true "Connected, enter the password" '{"needsSecret": true}'
  else
    result true "Connected"
  fi
}

unlock() { # id, secret as JSON on stdin
  local existing line hours
  existing="$(server "$1")"
  [[ -n "$existing" ]] || { result false "Unknown server $1"; return 1; }
  IFS= read -r line || true
  IN_SECRET="$(jq -r '.secret // ""' <<<"$line" 2>/dev/null)"
  IN_URL="$(jq -r .url <<<"$existing")"
  IN_USER="$(jq -r .user <<<"$existing")"
  IN_INSECURE="$(jq -r '.insecure // false' <<<"$existing")"
  IN_PROXY="$(jq -r '.proxy // ""' <<<"$existing")"
  hours="$(jq -r --argjson d "$SESSION_HOURS" '.sessionHours // $d' <<<"$existing")"

  # Only a secret Checkmk accepts unlocks the server
  local checked
  checked="$(check_connection)" || { echo "$checked"; return 1; }
  if [[ "$(jq -r '.remember' <<<"$existing")" == false ]]; then
    session_store "$1" "$IN_SECRET" "$hours" ||
      { result false "Could not keep the password in memory: keyctl (package keyutils) is missing"; return 1; }
    result true "Unlocked for $hours hours" "$(jq -c '{warnings}' <<<"$checked")"
  else
    local days
    days="$(remember_days "$existing")"
    local store
    store="$(store_secret "$1" "$IN_URL" "$IN_USER" "$IN_SECRET")"
    set_remembered_until "$1" $(($(date +%s) + days * 86400))
    if [[ "$store" == file ]]; then
      result true "Remembered for $days days in a file only you can read: there is no desktop keyring" "$(jq -c '{warnings}' <<<"$checked")"
    else
      result true "Remembered for $days days" "$(jq -c '{warnings}' <<<"$checked")"
    fi
  fi
}

lock() { # [id]
  local s
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    if [[ "$(jq -r '.remember' <<<"$s")" == false ]]; then
      session_clear "$(jq -r .id <<<"$s")"
    elif [[ -z "$(jq -r '.secretFile // ""' <<<"$s")" ]]; then
      forget_secret "$s"
    fi
  done < <(servers | jq -c --arg id "${1:-}" '.[] | select($id == "" or .id == $id)')
  result true "Locked"
}

# A servers.json that cannot be read is never taken for an empty one: the next
# save would replace it, and every server in it with it. Nothing runs until it
# is fixed.
check_servers_file() {
  [[ -e "$SERVERS" ]] || return 0
  local error
  error="$(jq -e '(.servers // []) | type == "array"' "$SERVERS" 2>&1 >/dev/null)" && return 0
  error="$(head -1 <<<"$error" | sed 's/^jq: //')"
  error="$SERVERS cannot be read (${error:-it holds no list of servers}). Fix it, or move it away to start over; until then nothing is changed."
  # The secret command's output is taken for a secret: the message goes elsewhere
  if [[ "${1:-}" == secret ]]; then echo "$error" >&2; else result false "$error"; fi
  return 1
}

check_servers_file "${1:-}" || exit 1
migrate_legacy
migrate_keyring
expire_secrets

case "${1:-}" in
  list) list ;;
  test) test_connection ;;
  save) save ;;
  delete) delete "${2:?server id}" ;;
  unlock) unlock "${2:?server id}" ;;
  lock) lock "${2:-}" ;;
  disconnect) set_disconnected "${2:?server id}" true ;;
  connect) set_disconnected "${2:?server id}" false ;;
  secret) s="$(server "${2:?server id}")"; [[ -n "$s" ]] && secret_of "$s" ;;
  *) sed -n '3,/^# The servers are kept/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 1 ;;
esac
